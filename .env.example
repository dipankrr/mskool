# ─────────────────────────────────────────────────────────────
# ONE root .env feeds the whole monorepo in local dev (loaded by
# `dotenv -e .env` in the root package.json scripts -> passed down
# to every app/package via turbo's `env` keys in turbo.json).
# In production there is NO .env file — your host (Railway/Render/
# Vercel/VPS) injects these as real environment variables instead.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# packages/db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_platform

# packages/auth + apps/api (better-auth)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000

# apps/api
PORT=4000
CORS_ORIGIN=http://localhost:3000

# apps/web (must be prefixed NEXT_PUBLIC_ to reach the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# packages/authz (Redis for the auth cache — zero DB calls at request time)
# Local: brew install redis && redis-server, or use a free Upstash instance
REDIS_URL=redis://localhost:6379
