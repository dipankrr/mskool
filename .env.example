# ─────────────────────────────────────────────────────────────
# ONE root .env feeds the whole monorepo in local dev (loaded by
# `dotenv -e .env` in the root package.json scripts -> passed down
# to every app/package via turbo's `env` keys in turbo.json).
# In production there is NO .env file — your host (Railway/Render/
# Vercel/VPS) injects these as real environment variables instead.
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit it.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── packages/db ──────────────────────────────────────────────
# We use managed Postgres (Neon). See docs/DECISIONS.md ADR-018.
#
# TWO urls, and they are not interchangeable:
#
#   DATABASE_URL         POOLED   — host contains `-pooler`. Used at runtime.
#   DIRECT_DATABASE_URL  DIRECT   — no `-pooler`. Used by drizzle-kit only.
#
# Migrations need a real session (DDL + advisory locks), which the pooled
# endpoint cannot give you — it is PgBouncer in transaction mode. Point
# them at the wrong one and migrations hang or half-apply.
#
# Both must end with `?sslmode=require`. Neon dashboard → Connection Details;
# the "Pooled connection" checkbox switches between the two hostnames.
#
# On a plain non-pooled Postgres, set DATABASE_URL only and delete the other.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/mskool?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/mskool?sslmode=require


# ── packages/auth + apps/api (better-auth) ───────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000

# ── apps/api ─────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ── apps/web (must be prefixed NEXT_PUBLIC_ to reach the browser) ──
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── packages/authz (Redis auth cache — zero DB calls at request time) ──
# Managed Redis (Upstash). Use the `rediss://` URL, not `redis://` — the
# extra `s` is TLS, which Upstash requires. Upstash console → Redis
# database → Connect → ioredis.
#
# Upstash bills per command and the free tier caps daily requests, so the
# 5-minute auth cache TTL in packages/authz/src/cache.ts is doing real work.
REDIS_URL=rediss://default:PASSWORD@REGION-NAME.upstash.io:6379
# ADR-009: the fee gateway webhook's HMAC key. MUST be set to a strong value in production.
FEE_WEBHOOK_SECRET=replace-with-a-long-random-string
