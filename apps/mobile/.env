# Expo CLI loads this file for every command (start, run:*, export) before it
# resolves the Metro server root. In this pnpm workspace, without this flag
# Metro resolves the project-relative entry `node_modules/expo-router/entry`
# against the monorepo root — where pnpm-isolated installs have no expo-router
# — and the bundle 404s. `getMetroServerRoot`/`resolveWorkspaceRoot` in
# @expo/config reads this as the supported escape hatch.
# See .kilo/plans/1791972469955-mobile-step0-foundation.md → "Native build
# resolution + device walk".
EXPO_NO_METRO_WORKSPACE_ROOT=1
