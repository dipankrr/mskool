auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false

# Windows MAX_PATH (260 chars): keep node_modules/.pnpm directory names short so
# native (CMake/Ninja) build paths inside node_modules stay under the limit.
#
# Why 12: Windows rejects *relative* paths when `cwd + relative` exceeds 260
# chars even if the resolved absolute path is shorter (the checked length is
# the un-resolved string, `..` included). Ninja stats CMake-generated paths
# like `../prefab/<abi>/...` relative to the build dir; at 32-char pnpm names
# those strings reached 264-270 chars, so ninja read existing files as
# "missing" and looped ("manifest still dirty after 100 tries"). 12 gives the
# worst observed path ~20 chars of margin. Measured worst absolute object path
# at 253 chars under the CMake `OBJECT_PATH_MAX=255` fix; the numbers and the
# config-plugin follow-up live in
# `.kilo/plans/1791972469955-mobile-step0-foundation.md`.
# Re-measure if the repo root gets deeper.
virtual-store-dir-max-length=12
