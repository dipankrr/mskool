{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ORIGIN",
        "PORT",
        "NEXT_PUBLIC_API_URL",
        "REDIS_URL",
        "FEE_WEBHOOK_SECRET",
        "DISABLE_RATE_LIMIT",
        "EXPO_PUBLIC_API_URL",
        "STORAGE_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY",
        "STORAGE_PRIVATE_BUCKET",
        "STORAGE_PUBLIC_BUCKET",
        "STORAGE_FORCE_PATH_STYLE",
        "PUBLIC_FILES_BASE_URL",
        "STORAGE_WORKER_DISABLED",
        "STORAGE_WORKER_TICK_SECONDS",
        "STORAGE_WORKER_BATCH"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ORIGIN",
        "PORT",
        "NEXT_PUBLIC_API_URL",
        "REDIS_URL",
        "FEE_WEBHOOK_SECRET",
        "DISABLE_RATE_LIMIT",
        "EXPO_PUBLIC_API_URL",
        "STORAGE_ENDPOINT",
        "STORAGE_REGION",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY",
        "STORAGE_PRIVATE_BUCKET",
        "STORAGE_PUBLIC_BUCKET",
        "STORAGE_FORCE_PATH_STYLE",
        "PUBLIC_FILES_BASE_URL",
        "STORAGE_WORKER_DISABLED",
        "STORAGE_WORKER_TICK_SECONDS",
        "STORAGE_WORKER_BATCH"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:seed": {
      "cache": false
    }
  }
}
