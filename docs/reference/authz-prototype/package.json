{
  "name": "school-authz-v2",
  "version": "2.0.0",
  "scripts": {
    "build":     "tsc",
    "typecheck": "tsc --noEmit",
    "dev":       "ts-node src/app.ts",
    "seed":      "ts-node -e \"require('./src/seeds/defaultPermissions').seedOrg(process.env.ORG_ID)\""
  },
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "express":     "^4.18.2",
    "ioredis":     "^5.3.2",
    "jsonwebtoken":"^9.0.2",
    "pg":          "^8.11.3"
  },
  "devDependencies": {
    "@types/express":      "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node":         "^20.11.0",
    "@types/pg":           "^8.10.9",
    "ts-node":             "^10.9.2",
    "typescript":          "^5.3.3"
  }
}
